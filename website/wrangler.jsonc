// The haypile.sh site as a Worker with static assets. The script runs on
// every request: it canonicalizes scheme and host, serves the install
// script to curl and wget on the root path, answers the agent discovery
// documents under /.well-known, and hands Markdown to clients that ask
// for it. Everything else is served straight from the static build in
// ./out.
{
	"name": "haypile-web",
	"main": "worker/index.js",
	"compatibility_date": "2026-07-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 }
	},
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "haypile.sh", "custom_domain": true },
		// www runs through the Worker on every path so it can 301 to the
		// apex; needs a proxied dummy DNS record for www (AAAA 100::).
		{ "pattern": "www.haypile.sh/*", "zone_name": "haypile.sh" }
	]
}
