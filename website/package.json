  "scripts": {
    "build": "cp ../install.sh public/install.sh && cp ../install.ps1 public/install.ps1 && mkdir -p public/agent-skills/haypile && cp ../SKILL.md public/agent-skills/haypile/SKILL.md && cp ../server.json public/mcp-server.json && next build",
